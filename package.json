{
  "name": "device-service-hub",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/portal",
    "apps/mobile",
    "apps/shell",
    "packages/contracts"
  ],
  "scripts": {
    "db:local:setup": "node scripts/postgres-local.mjs setup",
    "db:local:start": "node scripts/postgres-local.mjs start",
    "db:local:stop": "node scripts/postgres-local.mjs stop",
    "db:local:status": "node scripts/postgres-local.mjs status",
    "dev:api": "npm run build:api && npm run dev --workspace apps/api",
    "db:generate": "npm run db:generate --workspace apps/api",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:seed": "npm run build:api && npm run db:seed --workspace apps/api",
    "build:api": "npm run db:generate && npm run build --workspace apps/api",
    "verify:api": "node scripts/verify-api.mjs",
    "verify:api:restart": "node scripts/verify-api.mjs --after-restart",
    "verify:tickets": "node scripts/verify-tickets.mjs",
    "verify:tickets-ui": "node scripts/verify-tickets-ui.mjs",
    "verify:tickets:restart": "node scripts/verify-tickets.mjs --after-restart",
    "verify:assignment": "node scripts/verify-assignment.mjs",
    "verify:assignment-ui": "node scripts/verify-assignment-ui.mjs",
    "verify:tasks": "node scripts/verify-tasks.mjs",
    "verify:tasks-ui": "node scripts/verify-tasks-ui.mjs",
    "verify:results": "node scripts/verify-results.mjs",
    "verify:results-ui": "node scripts/verify-results-ui.mjs",
    "verify:confirmations": "node scripts/verify-confirmations.mjs",
    "verify:confirmations-ui": "node scripts/verify-confirmations-ui.mjs",
    "verify:shared-ui": "node scripts/verify-shared-ui.mjs",
    "verify:connected-ui": "node scripts/verify-connected-ui.mjs",
    "test:business": "node --test scripts/test-business-rules.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "format": "prettier --write apps/web/src apps/portal/src apps/portal/next.config.ts apps/portal/tsconfig.json apps/mobile/src apps/mobile/app.json apps/mobile/tsconfig.json apps/mobile/metro.config.cjs apps/api/src apps/api/prisma.config.ts packages/contracts/src \"scripts/**/*.mjs\"",
    "dev": "npm run dev --workspace apps/web",
    "dev:portal": "npm run dev --workspace apps/portal",
    "dev:mobile": "npm run start --workspace apps/mobile",
    "dev:mobile:web": "npm run web --workspace apps/mobile",
    "check:mobile": "npm run check --workspace apps/mobile",
    "build:mobile": "npm run build --workspace apps/mobile",
    "verify:mobile-ui": "node scripts/verify-mobile-ui.mjs",
    "open:mobile:android": "node scripts/open-mobile-android.mjs",
    "verify:mobile-android": "node scripts/verify-mobile-android.mjs",
    "verify:mobile-api": "node scripts/verify-mobile-api.mjs",
    "verify:mobile-auth-android": "node scripts/verify-mobile-auth-android.mjs",
    "start:portal": "npm run start --workspace apps/portal",
    "build:portal": "npm run build --workspace apps/portal",
    "verify:portal": "node scripts/verify-portal.mjs",
    "verify:portal-tickets": "node scripts/verify-portal-tickets.mjs",
    "verify:portal-confirmations": "node scripts/verify-portal-confirmations.mjs",
    "build": "npm run build:web && npm run build:api && npm run build:portal && npm run build:micro",
    "dev:shell": "npm run dev --workspace apps/shell",
    "build:shell": "npm run build --workspace apps/shell",
    "build:micro:web": "npm run build:micro --workspace apps/web",
    "preview:micro:web": "npm run preview:micro --workspace apps/web",
    "preview:shell": "npm run preview --workspace apps/shell",
    "build:micro": "npm run build:micro:web && npm run build:shell",
    "build:web": "npm run build --workspace apps/web",
    "preview": "npm run preview --workspace apps/web",
    "verify:mobile-tickets": "node scripts/verify-mobile-tickets.mjs",
    "verify:mobile-tickets-android": "node scripts/verify-mobile-tickets-android.mjs",
    "verify:mobile-confirmations": "node scripts/verify-mobile-confirmations.mjs",
    "verify:mobile-confirmations-android": "node scripts/verify-mobile-confirmations-android.mjs",
    "verify:mobile-tasks": "node scripts/verify-mobile-tasks.mjs",
    "verify:mobile-tasks-android": "node scripts/verify-mobile-tasks-android.mjs",
    "verify:mobile-results": "node scripts/verify-mobile-results.mjs",
    "verify:mobile-results-android": "node scripts/verify-mobile-results-android.mjs",
    "test:device-tags": "node --test scripts/test-device-tags.mjs",
    "verify:device-scan-api": "node scripts/verify-device-scan-api.mjs",
    "verify:device-scan-ui": "node scripts/verify-device-scan-ui.mjs",
    "verify:device-scan-android": "node scripts/verify-device-scan-android.mjs",
    "verify:device-camera-android": "node scripts/verify-device-camera-android.mjs",
    "verify:mobile-photos": "node scripts/verify-mobile-photos.mjs",
    "verify:mobile-photos-android": "node scripts/verify-mobile-photos-android.mjs",
    "verify:web-photos": "node scripts/verify-web-photos.mjs",
    "verify:micro": "node scripts/verify-micro.mjs"
  },
  "overrides": {
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
