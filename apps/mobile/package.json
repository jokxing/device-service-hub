{
  "name": "@device-service-hub/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --localhost --port 8081",
    "web": "expo start --web --localhost --port 8081",
    "check": "tsc --noEmit && expo install --check",
    "build": "tsc --noEmit && expo export --platform android --output-dir dist/android && expo export --platform web --output-dir dist/web"
  },
  "dependencies": {
    "@device-service-hub/contracts": "^0.1.0",
    "expo": "~57.0.32",
    "expo-constants": "~57.0.23",
    "expo-crypto": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.30",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
