generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  reporter
  technician
}

model User {
  id           String   @id
  username     String   @unique
  name         String
  role         Role
  passwordHash String
  active       Boolean  @default(true)
  sessions     Session[]
  deviceAccess DeviceAccess[]
  tickets      Ticket[] @relation("ReportedTickets")
  assignedTickets Ticket[] @relation("AssignedTickets")
  assignmentsMade TicketAssignment[] @relation("AssignmentActor")
  assignmentsReceived TicketAssignment[] @relation("AssignmentTechnician")
  acceptances TicketAcceptance[]
  results TicketResult[]
}

model Device {
  id       String @id
  code     String @unique
  name     String
  category String
  location String
  model    String
  enabled  Boolean @default(true)
  access   DeviceAccess[]
  tickets  Ticket[]
}

enum TicketStatus {
  pending
  assigned
  processing
  confirming
  completed
  cancelled
}

enum TicketPriority {
  normal
  urgent
}

model Ticket {
  id          String @id @default(uuid())
  number      Int @unique @default(autoincrement())
  reporterId  String
  deviceId    String
  title       String @db.VarChar(60)
  description String @db.VarChar(500)
  priority    TicketPriority
  status      TicketStatus @default(pending)
  assigneeId  String?
  assignedAt  DateTime?
  version     Int @default(0)
  requestId   String @db.Uuid
  requestHash String @db.Char(64)
  createdAt   DateTime @default(now())
  reporter    User @relation("ReportedTickets", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee    User? @relation("AssignedTickets", fields: [assigneeId], references: [id], onDelete: Restrict)
  device      Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  assignment  TicketAssignment?
  acceptance  TicketAcceptance?
  result      TicketResult?

  @@unique([reporterId, requestId])
  @@index([reporterId, createdAt, id])
  @@index([deviceId])
  @@index([status, createdAt, id])
  @@index([assigneeId])
}

model TicketResult {
  id              String @id @default(uuid())
  ticketId        String @unique
  actorId         String
  description     String @db.VarChar(2000)
  requestId       String @db.Uuid
  expectedVersion Int
  createdAt       DateTime @default(now())
  ticket          Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor           User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, requestId])
}

model TicketAcceptance {
  id              String @id @default(uuid())
  ticketId        String @unique
  actorId         String
  requestId       String @db.Uuid
  expectedVersion Int
  createdAt       DateTime @default(now())
  ticket          Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor           User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, requestId])
}

model TicketAssignment {
  id              String @id @default(uuid())
  ticketId        String @unique
  actorId         String
  assigneeId      String
  requestId       String @db.Uuid
  expectedVersion Int
  createdAt       DateTime @default(now())
  ticket          Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor           User @relation("AssignmentActor", fields: [actorId], references: [id], onDelete: Restrict)
  assignee        User @relation("AssignmentTechnician", fields: [assigneeId], references: [id], onDelete: Restrict)

  @@unique([actorId, requestId])
  @@index([assigneeId])
}

model DeviceAccess {
  userId   String
  deviceId String
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  @@id([userId, deviceId])
  @@index([deviceId])
}

model Session {
  id        String @id @default(uuid())
  tokenHash String @unique
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([userId])
  @@index([expiresAt])
}
