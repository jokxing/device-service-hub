{
  "expo": {
    "name": "设备服务",
    "slug": "device-service-hub-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "deviceservicehub",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "允许设备服务扫描设备二维码",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "android": {
      "package": "com.deviceservicehub.app"
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "设备服务移动端预览"
    }
  }
}
