{
  "expo": {
    "name": "设备服务",
    "slug": "device-service-hub-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "deviceservicehub",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router", "expo-secure-store"],
    "android": { "package": "com.deviceservicehub.app" },
    "ios": { "supportsTablet": true },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "设备服务移动端预览"
    }
  }
}
