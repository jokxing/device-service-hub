generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  reporter
  technician
}

model User {
  id           String   @id
  username     String   @unique
  name         String
  role         Role
  passwordHash String
  active       Boolean  @default(true)
  sessions     Session[]
  deviceAccess DeviceAccess[]
  tickets      Ticket[] @relation("ReportedTickets")
  assignedTickets Ticket[] @relation("AssignedTickets")
  assignmentsMade TicketAssignment[] @relation("AssignmentActor")
  assignmentsReceived TicketAssignment[] @relation("AssignmentTechnician")
  acceptances TicketAcceptance[]
  results TicketResult[]
  confirmations TicketConfirmation[]
  photos TicketPhoto[]
  quotes TicketQuote[]
  ordersConfirmed ServiceOrder[]
}

model Device {
  id       String @id
  code     String @unique
  name     String
  category String
  location String
  model    String
  enabled  Boolean @default(true)
  access   DeviceAccess[]
  tickets  Ticket[]
}

enum TicketStatus {
  pending
  assigned
  processing
  confirming
  completed
  cancelled
}

enum TicketPriority {
  normal
  urgent
}

enum TicketServiceMode {
  direct
  quoted
}

enum QuoteStatus {
  pending
  accepted
}

enum ServiceOrderStatus {
  awaiting_start
}

model Ticket {
  id          String @id @default(uuid())
  number      Int @unique @default(autoincrement())
  reporterId  String
  deviceId    String
  title       String @db.VarChar(60)
  description String @db.VarChar(500)
  priority    TicketPriority
  status      TicketStatus @default(pending)
  assigneeId  String?
  assignedAt  DateTime?
  version     Int @default(0)
  serviceMode TicketServiceMode @default(direct)
  requestId   String @db.Uuid
  requestHash String @db.Char(64)
  createdAt   DateTime @default(now())
  reporter    User @relation("ReportedTickets", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee    User? @relation("AssignedTickets", fields: [assigneeId], references: [id], onDelete: Restrict)
  device      Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  assignment  TicketAssignment?
  acceptance  TicketAcceptance?
  result      TicketResult?
  confirmation TicketConfirmation?
  photos TicketPhoto[]
  quotes TicketQuote[]
  order ServiceOrder?

  @@unique([reporterId, requestId])
  @@index([reporterId, createdAt, id])
  @@index([deviceId])
  @@index([status, createdAt, id])
  @@index([assigneeId])
}

model TicketPhoto {
  id String @id @db.Uuid
  ticketId String
  uploaderId String
  storageKey String @unique
  inputHash String @db.Char(64)
  width Int
  height Int
  bytes Int
  createdAt DateTime @default(now())
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  @@index([ticketId, createdAt])
}

model TicketConfirmation {
  id              String @id @default(uuid())
  ticketId        String @unique
  actorId         String
  requestId       String @db.Uuid
  expectedVersion Int
  createdAt       DateTime @default(now())
  ticket          Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor           User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, requestId])
}

model TicketResult {
  id              String @id @default(uuid())
  ticketId        String @unique
  actorId         String
  description     String @db.VarChar(2000)
  requestId       String @db.Uuid
  expectedVersion Int
  createdAt       DateTime @default(now())
  ticket          Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor           User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, requestId])
}

model TicketAcceptance {
  id              String @id @default(uuid())
  ticketId        String @unique
  actorId         String
  requestId       String @db.Uuid
  expectedVersion Int
  createdAt       DateTime @default(now())
  ticket          Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor           User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, requestId])
}

model TicketAssignment {
  id              String @id @default(uuid())
  ticketId        String @unique
  actorId         String
  assigneeId      String
  requestId       String @db.Uuid
  expectedVersion Int
  serviceMode     TicketServiceMode @default(direct)
  createdAt       DateTime @default(now())
  ticket          Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor           User @relation("AssignmentActor", fields: [actorId], references: [id], onDelete: Restrict)
  assignee        User @relation("AssignmentTechnician", fields: [assigneeId], references: [id], onDelete: Restrict)

  @@unique([actorId, requestId])
  @@index([assigneeId])
}

model TicketQuote {
  id              String @id @default(uuid())
  ticketId        String
  actorId         String
  revision        Int
  status          QuoteStatus @default(pending)
  currency        String @default("CNY") @db.Char(3)
  totalCents      Int
  requestId       String @db.Uuid
  requestHash     String @db.Char(64)
  expectedVersion Int
  createdAt       DateTime @default(now())
  ticket          Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor           User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  items           QuoteItem[]
  order           ServiceOrder?

  @@unique([ticketId, revision])
  @@unique([actorId, requestId])
}

model QuoteItem {
  id             String @id @default(uuid())
  quoteId        String
  position       Int
  name           String @db.VarChar(60)
  quantity       Int
  unitPriceCents Int
  amountCents    Int
  note           String @db.VarChar(200)
  quote          TicketQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, position])
}

model ServiceOrder {
  id              String @id @default(uuid())
  number          Int @unique @default(autoincrement())
  ticketId        String @unique
  quoteId         String @unique
  quoteRevision   Int
  status          ServiceOrderStatus @default(awaiting_start)
  currency        String @default("CNY") @db.Char(3)
  totalCents      Int
  actorId         String
  requestId       String @db.Uuid
  expectedVersion Int
  createdAt       DateTime @default(now())
  ticket          Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  quote           TicketQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  confirmedBy     User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  items           ServiceOrderItem[]

  @@unique([actorId, requestId])
}

model ServiceOrderItem {
  id             String @id @default(uuid())
  orderId        String
  position       Int
  name           String @db.VarChar(60)
  quantity       Int
  unitPriceCents Int
  amountCents    Int
  note           String @db.VarChar(200)
  order          ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, position])
}

model DeviceAccess {
  userId   String
  deviceId String
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  @@id([userId, deviceId])
  @@index([deviceId])
}

model Session {
  id        String @id @default(uuid())
  tokenHash String @unique
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([userId])
  @@index([expiresAt])
}
